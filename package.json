{
  "name": "acervo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Repositório pessoal de filmes, séries, jogos e livros — Web + Android (Capacitor).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
